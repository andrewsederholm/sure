<%# locals: (transaction:) %>
<% entry = transaction.entry %>
<% pending = transaction.pending? || entry.date > Date.current %>
<% open_path = transaction.transfer? && transaction.transfer.present? ? transfer_path(transaction.transfer) : entry_path(entry) %>
<li class="<%= class_names("flex items-center justify-between gap-3 px-3 py-2.5 text-sm", "opacity-50": entry.excluded?) %>">
  <div class="min-w-0 space-y-0.5">
    <%= link_to entry.name, open_path,
          data: { turbo_frame: "drawer", turbo_prefetch: false },
          class: "block truncate font-medium text-primary hover:underline" %>
    <p class="flex items-center gap-1.5 text-xs text-secondary min-w-0">
      <span class="truncate"><%= entry.account.name %></span>
      <% if transaction.category %>
        <span aria-hidden="true">·</span>
        <span class="truncate"><%= transaction.category.name %></span>
      <% end %>
      <% if entry.excluded? %>
        <span aria-hidden="true">·</span>
        <span><%= t("calendars.day_transaction.excluded") %></span>
      <% end %>
    </p>
  </div>

  <div class="flex items-center gap-2 shrink-0">
    <% if pending %>
      <%= render DS::Pill.new(
            label: t("transactions.transaction.pending"),
            tone: :neutral,
            marker: false,
            icon: "clock",
            title: t("transactions.transaction.pending_tooltip")) %>
    <% end %>
    <p class="<%= class_names("privacy-sensitive tabular-nums", "text-success": entry.amount.negative?, "italic": pending) %>">
      <%= format_money(-entry.amount_money) %>
    </p>
  </div>
</li>
